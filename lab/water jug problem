from collections import deque

def water_jug(jug1, jug2, target):
    # State = (water in jug1, water in jug2)
    start = (0, 0)
    queue = deque([(start, [])])
    visited = set()

    while queue:
        (x, y), path = queue.popleft()

        if (x, y) in visited:
            continue

        visited.add((x, y))
        path = path + [(x, y)]

        # Check if target is reached
        if x == target or y == target:
            return path

        # Possible next states
        next_states = [
            (jug1, y),   # Fill jug1
            (x, jug2),   # Fill jug2
            (0, y),      # Empty jug1
            (x, 0),      # Empty jug2
        ]

        # Pour jug1 -> jug2
        amount = min(x, jug2 - y)
        next_states.append((x - amount, y + amount))

        # Pour jug2 -> jug1
        amount = min(y, jug1 - x)
        next_states.append((x + amount, y - amount))

        for state in next_states:
            if state not in visited:
                queue.append((state, path))

    return None


# Example: 4-liter and 3-liter jugs, target = 2 liters
solution = water_jug(4, 3, 2)

if solution:
    print("Solution:")
    for state in solution:
        print(state)
else:
    print("No solution possible")
